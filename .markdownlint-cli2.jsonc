// Same rule set as the eslint monorepo's .markdownlint-cli2.jsonc.
{
  "config": {
    "MD012": false,
    "MD013": false,
    "MD022": false,
    "MD024": false,
    "MD025": false,
    "MD031": false,
    "MD032": false,
    "MD034": false,
    "MD036": false,
    "MD041": false,
    "MD046": false,
    "MD047": false,
    "MD051": false,
    "MD060": false,
    "MD026": false,
    "MD029": false,
    "MD037": false,
    "MD040": false,
    "MD049": false,
    "MD058": false,
    "MD033": {
      "allowed_elements": [
        "p",
        "a",
        "img",
        "br",
        "b",
        "i",
        "em",
        "strong",
        "details",
        "summary",
        "sub",
        "sup",
        "table",
        "thead",
        "tbody",
        "tr",
        "th",
        "td",
        "kbd",
        "picture",
        "source",
      ],
    },
  },
}
