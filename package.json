{
  "name": "security-research",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "npm run lint:oxlint && npm run lint:eslint && npm run lint:md && npm run format:check",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#**/node_modules\"",
    "format:check": "node scripts/format-changed.mjs",
    "lab-lint": "node scripts/lab-lint.mjs",
    "guard": "node scripts/open-finding-guard.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \"report/*.test.mjs\"",
    "secrets": "gitleaks git --redact --no-banner",
    "verify": "npm run test:scripts && npm run lab-lint && npm --prefix protocol-ctf run verify",
    "ci:local": "npm run lint && npm run verify",
    "report:dogfood": "node report/dogfood/build.mjs",
    "hunt": "node scripts/sr.mjs hunt",
    "finding": "node scripts/sr.mjs finding",
    "report-privately": "node scripts/sr.mjs report",
    "disclosure": "node scripts/sr.mjs disclosure",
    "publish-advisory": "node scripts/sr.mjs publish",
    "engagement": "node scripts/engagement.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-mcp-sdk-security": "^2.1.6",
    "eslint-plugin-node-security": "^6.3.3",
    "eslint-plugin-secure-coding": "^6.5.3",
    "lefthook": "^2.2.3",
    "markdownlint-cli2": "^0.24.2",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
