      },
      "results": [
        {
          "ruleId": "ai-1",
          "level": "error",
          "message": {
            "text": "Exploited: exec() runs the tool argument through a shell; the denylist is bypassable"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
