          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "protocol-ctf/challenges/websockets/ws-2/server.mjs"
                },
                "region": {
                  "startLine": 36,
                  "startColumn": 97
                }
              }
            }
          ]
        },
        {
          "ruleId": "secure-coding/detect-object-injection",
          "level": "error",
          "message": {
            "text": "Every key of an untrusted object is copied onto this target, so the caller chooses which field is written — including one they should not control, such as isAdmin"
