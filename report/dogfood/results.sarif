{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "eslint",
          "version": "eslint@9.39.5 eslint-plugin-node-security@6.3.3 eslint-plugin-secure-coding@6.5.3 eslint-plugin-mcp-sdk-security@2.1.6",
          "rules": [
            {
              "id": "node-security/require-secure-credential-storage"
            },
            {
              "id": "node-security/no-shell-injection"
            },
            {
              "id": "node-security/detect-eval-with-expression"
            },
            {
              "id": "secure-coding/no-hardcoded-credentials"
            },
            {
              "id": "secure-coding/no-insecure-comparison"
            },
            {
              "id": "secure-coding/no-improper-sanitization"
            },
            {
              "id": "secure-coding/detect-object-injection"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "node-security/require-secure-credential-storage",
          "level": "error",
          "message": {
            "text": "A credential assigned into process.env is inherited by every child process this app spawns, is readable at /proc/<pid>/environ, and is captured verbatim by crash dumps and by the environment snapshots error reporters send upstream."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "protocol-ctf/challenges/ai-agents/ai-1/server.mjs"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "node-security/no-shell-injection",
          "level": "error",
          "message": {
            "text": "Shell command built via string concatenation or template literal. An attacker who controls any interpolated value can execute arbitrary OS commands."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "protocol-ctf/challenges/ai-agents/ai-1/server.mjs"
                },
                "region": {
                  "startLine": 26,
                  "startColumn": 10
                }
              }
            }
          ]
        },
        {
          "ruleId": "node-security/detect-eval-with-expression",
